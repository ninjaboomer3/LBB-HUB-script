-- ============ CLICK LOGIC ============
local function getClickPosition()
	if fixedPosition then
		return fixedPosition.X, fixedPosition.Y
	end
	return clickX, clickY
end

local function performClick()
	local x, y = getClickPosition()
	if x == 0 and y == 0 then return end

	if clickMode == "Left" then
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
	else
		VirtualInputManager:SendMouseButtonEvent(x, y, 1, true, game, 0)
		VirtualInputManager:SendMouseButtonEvent(x, y, 1, false, game, 0)
	end
end

local function updateToggleVisuals()
	if clicking then
		toggleButton.Text = "■ STOP"
		toggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		bubble.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		bubbleIcon.Text = "■"
	else
		toggleButton.Text = "▶ START"
		toggleButton.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
		bubble.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
		bubbleIcon.Text = "▶"
	end
end

local function setClicking(state)
	clicking = state
	updateToggleVisuals()

	if clicking then
		task.spawn(function()
			while clicking do
				performClick()
				task.wait(clickInterval)
			end
		end)
	end
end

