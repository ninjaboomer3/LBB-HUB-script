-- ============ CUSTOM TOUCH/MOUSE DRAGGING ============
local function makeDraggable(dragHandle, target, onDragStateChanged)
	local dragging = false
	local dragStart = nil
	local startPos = nil
	local moved = false

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = target.Position
			if onDragStateChanged then onDragStateChanged(true) end

			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if onDragStateChanged then onDragStateChanged(false, moved) end
					conn:Disconnect()
				end
			end)
		end
	end)

	dragHandle.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 3 then moved = true end
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

makeDraggable(title, main)
makeDraggable(bubbleIcon, bubble, function(isDragging, wasMoved)
	bubbleDragging = isDragging
	if not isDragging then
		bubbleDidDrag = wasMoved
	end
end)

