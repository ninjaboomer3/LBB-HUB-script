-- ============ CLICK EXECUTION ============
local function getTargetScreenPos()
	-- absolute position of target CENTER, accounting for anchor
	local pos = target.AbsolutePosition
	local size = target.AbsoluteSize
	return pos.X + size.X / 2, pos.Y + size.Y / 2
end

local function performTouchTap(x, y)
	VirtualInputManager:SendTouchEvent(Vector2.new(x, y), Enum.UserInputState.Begin, game)
	task.wait(0.03)
	VirtualInputManager:SendTouchEvent(Vector2.new(x, y), Enum.UserInputState.End, game)
end

local function updateToggleVisuals()
	if clicking then
		toggleButton.Text = "■ STOP"
		toggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		bubble.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		bubbleIcon.Text = "■"
		ringStroke.Color = Color3.fromRGB(60, 220, 100)
		ringFill.BackgroundColor3 = Color3.fromRGB(60, 220, 100)
		crosshairV.BackgroundColor3 = Color3.fromRGB(60, 220, 100)
		crosshairH.BackgroundColor3 = Color3.fromRGB(60, 220, 100)
	else
		toggleButton.Text = "▶ START"
		toggleButton.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
		bubble.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
		bubbleIcon.Text = "▶"
		ringStroke.Color = Color3.fromRGB(255, 60, 60)
		ringFill.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
		crosshairV.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
		crosshairH.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
	end
end

local function setClicking(state)
	clicking = state
	updateToggleVisuals()
end

toggleButton.Activated:Connect(function()
	setClicking(not clicking)
end)

quickToggle.Activated:Connect(function()
	setClicking(not clicking)
end)

task.spawn(function()
	while true do
		if clicking then
			local x, y = getTargetScreenPos()
			local ok, err = pcall(performTouchTap, x, y)
			if not ok then
				warn("[AutoClicker] Click failed: " .. tostring(err))
			end
			task.wait(clickInterval)
		else
			task.wait(0.05)
		end
	end
end)

updateIntervalDisplay()
updateToggleVisuals()
