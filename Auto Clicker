-- ============ TOUCH DRAG HELPER ============
local function makeDraggableTouch(handle, targetFrame, onlyPrimaryTouch)
	local dragging = false
	local activeTouchId = nil
	local startTouchPos = nil
	local startFramePos = nil
	local moved = false

	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then return end
		if dragging then return end -- ignore extra fingers
		dragging = true
		moved = false
		activeTouchId = input
		startTouchPos = input.Position
		startFramePos = targetFrame.Position

		local conn
		conn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				activeTouchId = nil
				conn:Disconnect()
			end
		end)
	end)

	handle.InputChanged:Connect(function(input)
		if not dragging or input ~= activeTouchId then return end
		local delta = input.Position - startTouchPos
		if delta.Magnitude > 3 then moved = true end
		targetFrame.Position = UDim2.new(
			startFramePos.X.Scale, startFramePos.X.Offset + delta.X,
			startFramePos.Y.Scale, startFramePos.Y.Offset + delta.Y
		)
	end)

	return function() return moved end
end

