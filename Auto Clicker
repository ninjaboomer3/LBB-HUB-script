-- ============ TOUCH-BASED CLICK SIMULATION ============
local function performTouchTap(x, y)
	local touchId = 0
	VirtualInputManager:SendTouchEvent(Vector2.new(x, y), Enum.UserInputState.Begin, game)
	task.wait()
	VirtualInputManager:SendTouchEvent(Vector2.new(x, y), Enum.UserInputState.End, game)
end

local function getTapPosition()
	if fixedPosition then
		return fixedPosition.X, fixedPosition.Y
	end
	return touchX, touchY
end

local function updateToggleVisuals()
	if clicking then
		toggleButton.Text = "■ STOP"
		toggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		bubble.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		bubbleIcon.Text = "■"
	else
		toggleButton.Text = "▶ START"
		toggleButton.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
		bubble.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
		bubbleIcon.Text = "▶"
	end
end

toggleButton.Activated:Connect(function()
	clicking = not clicking
end)

task.spawn(function()
	while true do
		updateToggleVisuals()
		if clicking then
			local x, y = getTapPosition()
			if x ~= 0 or y ~= 0 then
				performTouchTap(x, y)
			end
		end
		task.wait(clickInterval)
	end
end)

-- ============ TRACK TOUCH POSITION + TAP-TO-SET ============
UserInputService.TouchTap:Connect(function(touchPositions, gameProcessed)
	if #touchPositions == 0 then return end
	local pos = touchPositions[1]
	touchX, touchY = pos.X, pos.Y

	if waitingForTap and not gameProcessed then
		fixedPosition = Vector2.new(pos.X, pos.Y)
		positionLabel.Text = string.format("Position: (%d, %d) [fixed]", fixedPosition.X, fixedPosition.Y)
		setPosButton.Text = "🎯 Set Click Position"
		waitingForTap = false
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.Touch then
		touchX, touchY = input.Position.X, input.Position.Y
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		touchX, touchY = input.Position.X, input.Position.Y
	end
end)

updateIntervalDisplay()
updateToggleVisuals()
