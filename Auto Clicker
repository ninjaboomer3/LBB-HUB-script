-- ============ INPUT TRACKING (touch + mouse position, and tap-to-set-position) ============
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.Touch then
		clickX, clickY = input.Position.X, input.Position.Y
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		clickX, clickY = input.Position.X, input.Position.Y
	end

	if waitingForTap and not gameProcessed then
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			fixedPosition = Vector2.new(input.Position.X, input.Position.Y)
			positionLabel.Text = string.format("Position: (%d, %d) [fixed]", fixedPosition.X, fixedPosition.Y)
			setPosButton.Text = "🎯 Set Click Position"
			waitingForTap = false
			return
		end
	end

	-- desktop hotkey still works if keyboard present
	if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == hotkey then
		setClicking(not clicking)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
		clickX, clickY = input.Position.X, input.Position.Y
	end
end)

